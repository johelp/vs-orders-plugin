# Copy to .dev.vars for local development (`npm run dev`). Never commit .dev.vars.

# Local-only admin login bypass. Honored ONLY on localhost AND when ACCESS_TEAM_DOMAIN is empty.
DEV_ADMIN_EMAIL=you@example.com

# Optional locally — without them, payments are disabled and emails are only logged.
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# MAILERLITE_API_KEY=...
